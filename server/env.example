# Copy to /etc/dbb-proxy/env (mode 600, owner dbb) and fill in on the server. Never commit real values.
# Which AI answers for everyone: qwen (primary) or gemini (backup) or anthropic. Change + restart to switch.
UPSTREAM=qwen

# Names are only for logs and per-person limits. One entry per person: name:code,name:code
# Generate a code with: openssl rand -base64 18
PASSCODES=CHANGE_ME_name:CHANGE_ME_code

ALLOWED_ORIGINS=https://brickbuilder.arcwel.ai
# ALLOW_LOCALHOST=1

HOST=127.0.0.1
PORT=8787

# Limits per person AND per connection, per upstream. Defaults shown. LIMIT_HOUR is off unless set.
LIMIT_DAY=qwen:60,gemini:10,anthropic:10
LIMIT_GLOBAL_DAY=qwen:300,gemini:30,anthropic:30
# LIMIT_HOUR=qwen:20
MAX_BODY_BYTES=1000000
MAX_TOKENS=4096
UPSTREAM_TIMEOUT_MS=90000
MAX_IN_FLIGHT=3

# qwen: OpenAI-compatible server (Ollama on the Mac, reached over Tailscale)
QWEN_BASE_URL=http://100.x.y.z:11434/v1
QWEN_MODEL=qwen3.5:9b
# QWEN_API_KEY=

# gemini (Google AI Studio key): the owner types this in by hand
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
