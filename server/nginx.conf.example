# After certbot runs, CHECK that port 80 redirects to https (passcodes must never travel in clear text).
# /etc/nginx/sites-available/dbb-proxy  (symlink into sites-enabled). Certbot adds the 443 block + certificate.
# in the http{} context (e.g. a file in /etc/nginx/conf.d/):
limit_req_zone $binary_remote_addr zone=dbb_proxy:1m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name brickbuilder-api.arcwel.ai;

    client_max_body_size 1m;
    access_log off;                       # no request logging here; the proxy logs one safe line per request
    error_log /var/log/nginx/dbb-proxy.error.log warn;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        limit_req zone=dbb_proxy burst=15 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append: clients cannot spoof their IP
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
